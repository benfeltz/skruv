; Written by hand, never by the editor. Imported with `godot --headless --path godot --import`.
; The main scene is scenes/world.tscn, a container whose one node runs world.gd: the room and
; JOHNNY are still built in code (JOHNNY from items/johnny.json), so the editor can open and
; Play it. The loop still starts through `-s res://main.gd`.

config_version=5

[application]

config/name="Skruv"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

; Typed GDScript is enforced: an untyped declaration is a compile error, not a warning.
; Addons are exempt (exclude_addons is on by default).
gdscript/warnings/untyped_declaration=2

[physics]

; Jolt, set explicitly, so the stillness result is about Jolt and not whatever the default is.
3d/physics_engine="Jolt Physics"
; Tuning attempt 1 (step 5): solver iterations, from Jolt's 10 and 2.
jolt_physics_3d/simulation/velocity_steps=100
jolt_physics_3d/simulation/position_steps=20
; Tuning attempt 4 (step 5, beyond the plan): contact slop and speculative distance, from 20 mm.
jolt_physics_3d/simulation/penetration_slop=0.001
; Tuning attempt 3 (2.0.4.4 step 7): back to Jolt's 20 mm, which 2.0.4.2 found catches a shelf on its pins.
jolt_physics_3d/simulation/speculative_contact_distance=0.02

[editor_plugins]

; Enabled by editing this file. No editor step. loop.sh fetches gdUnit4; godot_mcp is committed.
enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/godot_mcp/plugin.cfg")

[godot_mcp]

; The godot_mcp addon (voidrot/godot-mcp @ 57715ac, copied into addons/) serves the editor as an
; MCP server. The port is set here by hand so the editor never writes it into this file.
server/port=6550
