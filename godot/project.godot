; Written by hand, never by the editor. Imported with `godot --headless --path godot --import`.
; There is no main scene on purpose: scenes are built in GDScript, and the project always
; starts through `-s res://main.gd`. Running it bare pops a native "no main scene" alert.

config_version=5

[application]

config/name="Skruv"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

; Typed GDScript is enforced: an untyped declaration is a compile error, not a warning.
; Addons are exempt (exclude_addons is on by default).
gdscript/warnings/untyped_declaration=2

[editor_plugins]

; Enabled by editing this file. No editor step. scripts/loop.sh fetches the addon.
enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")
